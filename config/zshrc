if [[ -d "$HOME/.opencode" ]]; then
  export PATH="$HOME/.opencode/bin:$PATH"
fi

alias claude='claude --allow-dangerously-skip-permissions'
alias pmux='tmux new-session -A -s primary' # Reattach to or start the primary session

# Modern replacements for classic tools
alias ls='eza'
alias ll='eza -l'
alias la='eza -la'
alias tree='eza --tree'
alias cat='bat'
alias ping='prettyping'

# Auto-start the "primary" tmux session, except inside IDE terminals
# (Zed, IntelliJ, VS Code) or when already inside tmux. In Ghostty, only
# the first tab auto-attaches: later tabs see a client already attached
# to the primary session and skip.
if [[ -o interactive && -z "$TMUX" ]] \
  && [[ "$TERM_PROGRAM" != "vscode" && "$TERM_PROGRAM" != "zed" ]] \
  && [[ "$TERMINAL_EMULATOR" != "JetBrains-JediTerm" ]] \
  && command -v tmux >/dev/null \
  && ! { [[ "$TERM_PROGRAM" == "ghostty" ]] \
         && tmux list-clients -t primary 2>/dev/null | grep -q .; }; then
  exec tmux new-session -A -s primary
fi

if [ -f ~/.zshrc.local ]; then
  # An override to give local settings.
  source ~/.zshrc.local
fi

# Enable zsh's completion system — picks up Homebrew-installed completions
# (starship, gh, git, eza, ...) from /opt/homebrew/share/zsh/site-functions
autoload -Uz compinit && compinit

# Starship prompt (must come after compinit)
eval "$(starship init zsh)"
